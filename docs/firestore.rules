rules_version = '2';
// WaveFern: paste this into Firebase console > Firestore Database > Rules, then Publish.
// Only what the game uses is allowed; everything else is refused. No get()/exists() lookups, so rules never cost extra reads.
// saves/{uid}: a Google player reads and writes only their own save; the admin reads all.
// gifts/{id}: the admin creates and deletes; a player reads their own and marks one claimed once.
// rooms/{code}: a band host (anonymous login) writes a heartbeat carrying their own uid; only the admin reads.
service cloud.firestore {
  match /databases/{database}/documents {
    function me() { return request.auth.uid; }
    function google() { return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com'; }
    function admin() { return google() && me() == 'wE6oPZIHYifrqBFxzpPse6ripGY2'; }
    function fields(k) { return request.resource.data.keys().toSet() == k.toSet(); }
    function stamp(v) { return v is int && v > 1704067200000 && v < request.time.toMillis() + 604800000; }
    function count(v) { return v is int && v >= 0 && v <= 1000000000000; }
    function str(v, lo, hi) { return v is string && v.size() >= lo && v.size() <= hi; }

    match /saves/{uid} {
      allow get: if google() && me() == uid || admin();
      allow list: if admin() && request.query.limit <= 100;
      allow create, update: if google() && me() == uid && saveOk(request.resource.data);
      function saveOk(d) {
        return fields(['code', 'day', 'artist', 't']) && str(d.code, 1, 999999)
          && d.day is number && d.day >= 0 && d.day <= 1000000 && str(d.artist, 0, 64) && stamp(d.t);
      }
    }

    match /gifts/{id} {
      allow get, list: if admin() || google() && resource.data.to == me();
      allow create: if admin() && giftOk(request.resource.data);
      allow update: if google() && resource.data.to == me() && resource.data.claimed == false
        && request.resource.data.diff(resource.data).affectedKeys() == ['claimed'].toSet()
        && request.resource.data.claimed == true;
      allow delete: if admin();
      function giftOk(d) {
        return fields(['to', 'from', 'msg', 'money', 'streams', 'listeners', 't', 'claimed'])
          && d.to is string && d.to.matches('[A-Za-z0-9]{10,128}') && str(d.from, 0, 40) && str(d.msg, 0, 200)
          && count(d.money) && count(d.streams) && count(d.listeners) && stamp(d.t) && d.claimed == false;
      }
    }

    match /rooms/{code} {
      allow get, list: if admin();
      allow create: if request.auth != null && roomOk(request.resource.data);
      allow update: if request.auth != null && resource.data.uid == me() && roomOk(request.resource.data);
      allow delete: if admin() || request.auth != null && resource.data.uid == me();
      function roomOk(d) {
        return code.matches('[A-Z0-9]{5}') && fields(['code', 'band', 'n', 'uid', 't'])
          && d.code == code && d.uid == me() && str(d.band, 1, 24) && d.n is int && d.n >= 1 && d.n <= 4 && stamp(d.t);
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
