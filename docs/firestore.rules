rules_version = '2';
// WaveFern: paste this into Firebase console > Firestore Database > Rules, then Publish.
// Saves: each signed-in player can read and write only their own save at saves/{their uid}; the admin can read every save.
// Gifts: only the admin can create or delete gifts; a player can only read gifts sent to them and mark them claimed.
// Nothing else is open: any other path (and any delete of a save) is denied by default.
// Band rooms (multiplayer) do not use Firestore, so no rules are needed for them.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'wE6oPZIHYifrqBFxzpPse6ripGY2';
    }
    function isCount(v) {
      return v is int && v >= 0 && v <= 1000000000000;
    }
    function isStamp(v) {
      // millisecond timestamp, not absurdly far in the future (clock skew allowed)
      return v is number && v >= 0 && v <= request.time.toMillis() + 604800000;
    }
    match /saves/{uid} {
      // players read only their own save; only the admin may list saves
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code', 'day', 'artist', 't'])
        && request.resource.data.keys().hasAll(['code', 'day', 'artist', 't'])
        && request.resource.data.code is string && request.resource.data.code.size() > 0 && request.resource.data.code.size() < 1000000
        && request.resource.data.day is number && request.resource.data.day >= 0 && request.resource.data.day <= 1000000
        && request.resource.data.artist is string && request.resource.data.artist.size() < 200
        && isStamp(request.resource.data.t);
      allow delete: if false;
    }
    match /gifts/{id} {
      allow get, list: if isAdmin() || (request.auth != null && resource.data.to == request.auth.uid);
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['to', 'from', 'msg', 'money', 'streams', 'listeners', 't', 'claimed'])
        && request.resource.data.to is string && request.resource.data.to.size() > 0 && request.resource.data.to.size() <= 128
        && request.resource.data.from is string && request.resource.data.from.size() <= 40
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 200
        && isCount(request.resource.data.money) && isCount(request.resource.data.streams) && isCount(request.resource.data.listeners)
        && request.resource.data.keys().hasAll(['to', 'from', 'msg', 'money', 'streams', 'listeners', 't', 'claimed'])
        && isStamp(request.resource.data.t) && request.resource.data.claimed == false;
      allow update: if request.auth != null && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed'])
        && request.resource.data.claimed == true;
      allow delete: if isAdmin();
    }
    // everything else: denied
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
