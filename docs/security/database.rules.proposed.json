{
  "rules": {
    "r": {
      "$code": {
        ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && $code.matches(/^[A-Z0-9]{5}$/) && (!data.exists() || data.child('h/u').val() == auth.uid) && (!newData.exists() || newData.child('h/u').val() == auth.uid)",
        "h": {
          ".read": "auth != null",
          ".validate": "newData.hasChildren(['u', 't'])",
          "u": {
            ".validate": "newData.val() == auth.uid"
          },
          "t": {
            ".validate": "newData.val() == now"
          },
          "$other": {
            ".validate": false
          }
        },
        "i": {
          ".read": "auth != null",
          ".validate": "newData.hasChildren(['b', 'n', 'k'])",
          "b": {
            ".validate": "newData.isString() && newData.val().length <= 24 && newData.val().matches(/^[^<>\"]*$/)"
          },
          "n": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4"
          },
          "k": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "$other": {
            ".validate": false
          }
        },
        "u": {
          ".read": "auth != null && data.parent().child('h/u').val() == auth.uid",
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && auth.token.firebase.sign_in_provider == 'google.com' && data.parent().parent().child('h').exists()",
            "o": {
              ".validate": "newData.val() == 1"
            },
            "p": {
              ".validate": "newData.isString() && newData.val().length <= 40 && newData.val().matches(/^[-0-9., ]*$/)"
            },
            "m": {
              ".validate": "newData.isString() && newData.val().length <= 400"
            },
            "l": {
              ".validate": "newData.isString() && newData.val().length <= 4000"
            },
            "e": {
              "$k": {
                ".validate": "newData.isString() && newData.val().length <= 100000"
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "d": {
          "$uid": {
            ".read": "auth != null && auth.uid == $uid",
            "c": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "e": {
              "$k": {
                ".write": "auth != null && auth.uid == $uid && !newData.exists()",
                ".validate": "newData.isString() && newData.val().length <= 200000"
              }
            },
            "p": {
              "$m": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              }
            },
            "m": {
              "$m": {
                ".validate": "newData.isString() && newData.val().length <= 400"
              }
            },
            "l": {
              "$m": {
                ".validate": "newData.isString() && newData.val().length <= 4000"
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "f": {
      "n": {
        "$h": {
          ".read": "auth != null",
          ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && ((!data.exists() && newData.val() == auth.uid) || (data.val() == auth.uid && !newData.exists()))",
          ".validate": "$h.matches(/^[a-z0-9_]{3,16}$/) && newData.isString()"
        }
      },
      "p": {
        "$uid": {
          ".read": "auth != null && (auth.uid == $uid || root.child('f/l/' + $uid + '/' + auth.uid).exists())",
          ".write": "auth != null && auth.uid == $uid && auth.token.firebase.sign_in_provider == 'google.com'",
          ".validate": "newData.hasChildren(['h', 't']) && newData.parent().parent().child('n/' + newData.child('h').val()).val() == $uid",
          "h": {
            ".validate": "newData.isString() && newData.val().length <= 16"
          },
          "nm": {
            ".validate": "newData.isString() && newData.val().length <= 24 && newData.val().matches(/^[^<>\"]*$/)"
          },
          "o": {
            ".validate": "newData.val() == 1"
          },
          "rm": {
            ".validate": "newData.isString() && newData.val().matches(/^([A-Z0-9]{5})?$/)"
          },
          "t": {
            ".validate": "newData.isNumber() && newData.val() == now"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "l": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          "$f": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && ((auth.uid == $uid && (!newData.exists() || root.child('f/q/' + $uid + '/' + $f).exists() || root.child('f/l/' + $f + '/' + $uid).exists())) || (auth.uid == $f && (!newData.exists() || root.child('f/q/' + $f + '/' + $uid).exists())))",
            ".validate": "newData.val() == true"
          }
        }
      },
      "q": {
        "$to": {
          ".read": "auth != null && auth.uid == $to",
          "$from": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && ((auth.uid == $to && !newData.exists()) || (auth.uid == $from && !newData.exists()) || (auth.uid == $from && $to != $from && !data.exists() && !root.child('f/b/' + $to + '/' + $from).exists() && !root.child('f/l/' + $to + '/' + $from).exists()))",
            ".validate": "newData.hasChildren(['h', 't']) && newData.child('t').val() == now && newData.parent().parent().parent().child('s/' + $from).val() == now && root.child('f/n/' + newData.child('h').val()).val() == $from",
            "h": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "nm": {
              ".validate": "newData.isString() && newData.val().length <= 24 && newData.val().matches(/^[^<>\"]*$/)"
            },
            "t": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "s": {
        "$uid": {
          ".write": "auth != null && auth.uid == $uid && auth.token.firebase.sign_in_provider == 'google.com'",
          ".validate": "newData.val() == now && (!data.exists() || now - data.val() > 10000)"
        }
      },
      "b": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          "$x": {
            ".write": "auth != null && auth.uid == $uid && auth.token.firebase.sign_in_provider == 'google.com'",
            ".validate": "newData.isString() && newData.val().length <= 24 && newData.val().matches(/^[^<>\"]*$/)"
          }
        }
      },
      "i": {
        "$to": {
          ".read": "auth != null && auth.uid == $to",
          "$from": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && ((auth.uid == $to && !newData.exists()) || (auth.uid == $from && !newData.exists()) || (auth.uid == $from && root.child('f/l/' + $to + '/' + $from).exists() && !root.child('f/b/' + $to + '/' + $from).exists() && (!data.exists() || now - data.child('t').val() > 15000)))",
            ".validate": "newData.hasChildren(['c', 'b', 'nm', 't']) && newData.child('t').val() == now",
            "c": {
              ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9]{5}$/)"
            },
            "b": {
              ".validate": "newData.isString() && newData.val().length <= 24 && newData.val().matches(/^[^<>\"]*$/)"
            },
            "nm": {
              ".validate": "newData.isString() && newData.val().length <= 24 && newData.val().matches(/^[^<>\"]*$/)"
            },
            "t": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "$other": {
        ".validate": false
      }
    }
  }
}
