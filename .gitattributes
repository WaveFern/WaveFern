# Git LFS for large binary files
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
# keep the menu music as a normal file so GitHub Pages serves the real mp3 (the deploy workflow does not fetch LFS)
menu.mp3 -filter -diff -merge binary
favicon.png -filter -diff -merge binary
# one-shot samples: plain files so GitHub Pages serves the real mp3 (the deploy workflow does not fetch LFS)
audio/oneshots/*.mp3 -filter -diff -merge binary
# soundtrack and wallpaper (were base64 in assets.js): plain files so GitHub Pages serves the real files
assets/* -filter -diff -merge binary
# new soundtrack tracks: plain files so GitHub Pages serves the real mp3
audio/box.mp3 -filter -diff -merge binary
audio/catch.mp3 -filter -diff -merge binary
audio/applause.mp3 -filter -diff -merge binary
